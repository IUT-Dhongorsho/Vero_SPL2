PORT=8007
NODE_ENV=development
DATABASE_URL=postgres://user:password@localhost:5432/meet_db
REDIS_URL=redis://localhost:6379
BETTER_AUTH_SECRET=your_better_auth_secret_here
AUTH_SERVICE_URL=http://localhost:8001
CLIENT_URL=http://localhost:3000

# Mediasoup — set to 'auto' to automatically detect the active LAN IP, or set to an explicit public IP
MEDIASOUP_ANNOUNCED_IP=auto
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=49999

# TURN server — optional, only needed for clients behind symmetric NAT
TURN_SERVER_URL=
TURN_USERNAME=
TURN_PASSWORD=

# Notes Integration
NOTES_SERVICE_URL=http://localhost:8003

# Whisper & Gemini AI Keys
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
