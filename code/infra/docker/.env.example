# Copy to infra/docker/.env and fill in. Used by docker-compose.yml.

# Where people open Vero — every service builds links from it.
PUBLIC_URL=https://vero-spl2.shares.zrok.io
HTTP_PORT=3000

POSTGRES_PASSWORD=change-me
# Signs sessions and the JWTs the services share. Long and random.
BETTER_AUTH_SECRET=
BETTER_AUTH_API_KEY=

# Optional sign-in providers (redirect URI: $PUBLIC_URL/api/better-auth/callback/<provider>)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email (password resets, notifications). Leave SMTP_HOST empty to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Browser push. Generate a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# AI summaries. Without a key the app keeps its AI buttons disabled.
GEMINI_API_KEY=
GEMINI_MODEL=

# Monitoring only (docker compose --profile monitoring up): Grafana's admin sign-in.
# Anyone can view the dashboard; this account is needed to edit it.
GRAFANA_ADMIN_PASSWORD=admin

# Meet only (docker compose --profile meet up): the address browsers reach for media.
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
