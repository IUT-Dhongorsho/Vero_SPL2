# One image recipe for every Node service and ai-worker.
#
#   docker build -f Dockerfile.service \
#     --build-arg SERVICE_NAME=notes-service \
#     --build-arg SERVICE_PATH=services/notes-service .
#
# Built from the monorepo root so workspace packages (@repo/shared) resolve.

FROM node:22-alpine AS builder
RUN corepack enable && corepack prepare pnpm@8.15.0 --activate
WORKDIR /app

ARG SERVICE_NAME
ARG SERVICE_PATH

COPY . .
# Only this service and the workspace packages it depends on.
RUN pnpm install --frozen-lockfile --filter "${SERVICE_NAME}..."
RUN pnpm --filter "${SERVICE_NAME}..." run build
# tsc does not copy the SQL migrations next to the compiled migrator.
RUN if [ -d "${SERVICE_PATH}/src/db/migrations" ]; then \
      mkdir -p "${SERVICE_PATH}/dist/db" && cp -R "${SERVICE_PATH}/src/db/migrations" "${SERVICE_PATH}/dist/db/"; \
    fi

FROM node:22-alpine AS runner
ENV NODE_ENV=production
ARG SERVICE_PATH
WORKDIR /app
COPY --from=builder /app /app
WORKDIR /app/${SERVICE_PATH}

# Bring the schema up to date, then start the service.
CMD ["sh", "-c", "if [ -f dist/db/migrate.js ]; then node dist/db/migrate.js; fi && exec npm start --silent"]
